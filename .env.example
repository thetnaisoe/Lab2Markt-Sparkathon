# Copy to backend/.env for local runs (loaded by app/env.py). Never commit the real file.
# On Render, set the same names under Environment.

# LLM: "anthropic", "openai", or an OpenAI-compatible alias: gemini, mistral, groq, openrouter, azure
LLM_PROVIDER=
LLM_API_KEY=
# Required for OpenAI-compatible providers
LLM_MODEL=
# Optional custom OpenAI-compatible endpoint (required for azure)
LLM_BASE_URL=

# Optional tuning: uncomment a line and set a number to override the default.
# LLM call cap per run, default 40
# LLM_MAX_CALLS_PER_RUN=
# SDK retries with backoff on rate limits and server errors, default 2
# LLM_MAX_RETRIES=
# Parallel LLM calls in research, default 4; use 1-2 on free tiers
# RESEARCH_LLM_WORKERS=

# Web research (optional; without it research uses OpenAlex only)
TAVILY_API_KEY=
